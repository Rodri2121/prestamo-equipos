# Copia este archivo como .env (en esta misma carpeta backend) y completa los valores.
# El archivo .env esta en .gitignore: los secretos no se suben al repositorio.

DB_URL=jdbc:postgresql://localhost:5432/prestamos_equipos
DB_USERNAME=postgres
DB_PASSWORD=tu_contrasena_de_postgres

# Clave para firmar los JWT (HS256): minimo 32 caracteres, aleatoria.
# Generar en PowerShell:  [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET=reemplazar-por-una-clave-larga-y-aleatoria-de-32+caracteres
JWT_EXPIRACION_MINUTOS=60

CORS_ORIGENES=http://localhost:5173
