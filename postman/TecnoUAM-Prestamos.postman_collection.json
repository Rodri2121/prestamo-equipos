              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"Rol USER\", () => pm.expect(r.rol).to.eql(\"USER\"));",
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"tokenUser\", r.token);"
                ]
              }
            }
          ]
        },
